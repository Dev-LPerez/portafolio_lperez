---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="404 — Página no encontrada"
  description="La página que buscas no existe o fue movida a otra dirección."
>
  <div class="error-page">
    <p class="display error-code" aria-hidden="true">404</p>
    <h1 class="error-title">Página no encontrada</h1>
    <p class="error-message">
      La página que buscas no existe o fue movida a otra dirección.
    </p>
    <div class="error-actions">
      <a href="/" class="btn btn--solid" id="not-found-home">
        Ir al inicio
      </a>
      <a href="/proyectos" class="btn btn--outline" id="not-found-projects">
        Ver proyectos
      </a>
    </div>
  </div>
</Layout>
