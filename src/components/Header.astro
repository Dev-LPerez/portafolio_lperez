---
import { profile } from "@/lib/profile";
import Logo from "@/components/Logo.astro";

const pathname = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Inicio", num: "01" },
  { href: "/sobre-mi", label: "Sobre mí", num: "02" },
  { href: "/proyectos", label: "Proyectos", num: "03" },
  { href: "/contacto", label: "Contacto", num: "04" },
];

function isActive(href: string) {
  if (href === "/") return pathname === "/" || pathname === "";
  return pathname.startsWith(href);
}
---

<header class="header-sticky" id="site-header">
  <div class="container header-inner">
    {/* Logo con nombre accesible explícito */}
    <a
      href="/"
      class="logo"
      aria-label={`${profile.name} - Ir al inicio`}
    >
      <Logo variant="wordmark" size="md" />
      <span class="sr-only">{profile.name}</span>
    </a>

    {/* Nav centrada – solo escritorio */}
    <nav class="nav-desktop" aria-label="Navegación principal">
      {navLinks.map(({ href, label }) => {
        const active = isActive(href);
        return (
          <a
            href={href}
            class={`nav-link${active ? " nav-link--active" : ""}`}
            aria-current={active ? "page" : undefined}
          >
            {label}
          </a>
        );
      })}
    </nav>

    {/* Controles de la derecha */}
    <div class="header-actions">
      {/* CTA Contacto visible en desktop y tablets */}
      <a
        href={`mailto:${profile.email}`}
        class="btn btn--solid btn--sm header-cta-btn"
        id="header-contact-cta"
        aria-label={`Enviar correo a ${profile.email}`}
      >
        Contacto
      </a>

      {/* Botón Hamburguesa accesible para Móvil */}
      <button
        type="button"
        class="header-burger-btn"
        id="mobile-drawer-trigger"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-navigation-drawer"
      >
        <span class="burger-line burger-line--top" aria-hidden="true"></span>
        <span class="burger-line burger-line--mid" aria-hidden="true"></span>
        <span class="burger-line burger-line--bot" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  {/* ── MENÚ / DRAWER MÓVIL ────────────────────────── */}
  <div
    id="mobile-navigation-drawer"
    class="mobile-drawer"
    aria-hidden="true"
  >
    {/* Fondo con desenfoque / Backdrop */}
    <div
      class="mobile-drawer-backdrop"
      id="drawer-backdrop"
      aria-hidden="true"
    ></div>

    {/* Panel de navegación desplegable */}
    <div class="mobile-drawer-panel">
      <div class="container mobile-drawer-content">
        {/* Título de sección accesible oculto para tecnologías asistivas */}
        <h2 class="sr-only">Menú de navegación móvil</h2>

        {/* Estado de disponibilidad */}
        <div class="mobile-drawer-status">
          <span class="hero-status">
            <span class="hero-status-dot" aria-hidden="true"></span>
            Disponible para proyectos
          </span>
        </div>

        {/* Enlaces de navegación principales */}
        <nav class="mobile-drawer-nav" aria-label="Enlaces del menú móvil">
          {navLinks.map(({ href, label, num }) => {
            const active = isActive(href);
            return (
              <a
                href={href}
                class={`mobile-nav-item drawer-nav-link ${active ? "mobile-nav-item--active" : ""}`}
                aria-current={active ? "page" : undefined}
                aria-label={`Ir a sección: ${label}`}
              >
                <span class="mobile-nav-num" aria-hidden="true">{num}</span>
                <span class="mobile-nav-label display">{label}</span>
                <span class="mobile-nav-arrow" aria-hidden="true">→</span>
              </a>
            );
          })}
        </nav>

        {/* Tarjeta de contacto rápido y redes */}
        <div class="mobile-drawer-footer">
          <p class="eyebrow" style="margin-bottom: 0.6rem;">Contacto directo</p>
          <a
            href={`mailto:${profile.email}`}
            class="mobile-drawer-email"
            aria-label={`Enviar correo a ${profile.email}`}
          >
            {profile.email}
          </a>

          <div class="mobile-drawer-socials">
            <a
              href={profile.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="mobile-social-btn"
              aria-label="Perfil de GitHub de Luis"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" style="width: 1.1rem; height: 1.1rem;" aria-hidden="true">
                <title>GitHub</title>
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
              </svg>
              <span>GitHub</span>
            </a>
            <a
              href={profile.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="mobile-social-btn"
              aria-label="Perfil de LinkedIn de Luis"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" style="width: 1.1rem; height: 1.1rem;" aria-hidden="true">
                <title>LinkedIn</title>
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
              <span>LinkedIn</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  function setupHeader() {
    const trigger = document.getElementById("mobile-drawer-trigger");
    const drawer = document.getElementById("mobile-navigation-drawer");
    const backdrop = document.getElementById("drawer-backdrop");
    const links = document.querySelectorAll(".drawer-nav-link");

    if (!trigger || !drawer) return;

    let isOpen = false;

    function openDrawer() {
      isOpen = true;
      drawer.classList.add("is-open");
      drawer.setAttribute("aria-hidden", "false");
      trigger.classList.add("is-active");
      trigger.setAttribute("aria-expanded", "true");
      trigger.setAttribute("aria-label", "Cerrar menú de navegación");
      document.body.style.overflow = "hidden";
    }

    function closeDrawer() {
      isOpen = false;
      drawer.classList.remove("is-open");
      drawer.setAttribute("aria-hidden", "true");
      trigger.classList.remove("is-active");
      trigger.setAttribute("aria-expanded", "false");
      trigger.setAttribute("aria-label", "Abrir menú de navegación");
      document.body.style.overflow = "";
      trigger.focus();
    }

    trigger.addEventListener("click", () => {
      if (isOpen) closeDrawer();
      else openDrawer();
    });

    backdrop?.addEventListener("click", closeDrawer);

    links.forEach((link) => {
      link.addEventListener("click", closeDrawer);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) {
        closeDrawer();
      } else if (e.key === "Tab" && isOpen) {
        const focusable = drawer.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled])'
        );
        if (focusable.length > 0) {
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    });
  }

  // Ejecutar tanto en la carga inicial como en cada navegación de View Transitions
  setupHeader();
  document.addEventListener("astro:page-load", setupHeader);
</script>
